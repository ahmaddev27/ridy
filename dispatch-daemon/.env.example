# Ridy Laravel API base URL
RIDY_API_URL=http://localhost:8090

# Shared secret — must match the backend's DISPATCH_INGEST_SECRET
DISPATCH_INGEST_SECRET=local-dev-dispatch-secret

# Uber RAMEN dispatch stream
UBER_DISPATCH_BASE_URL=https://vsdispatch.uber.com
UBER_RAMEN_PATH=/ramendca/events

# Tuning (optional)
SESSION_POLL_INTERVAL_MS=60000
RECONNECT_MIN_MS=2000
RECONNECT_MAX_MS=60000
