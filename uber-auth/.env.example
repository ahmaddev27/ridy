# Port this service listens on
UBER_AUTH_PORT=8791

# Shared secret — Laravel sends it as X-Auth-Secret (match UBER_AUTH_SECRET in backend .env)
UBER_AUTH_SECRET=local-dev-uber-auth-secret

# Uber fleet dispatch dashboard (sign-in lands here)
UBER_DASHBOARD_URL=https://vsdispatch.uber.com/

# Show the browser window while debugging locally (1 = visible)
HEADFUL=0

# Timeouts (ms)
UBER_AUTH_STEP_TIMEOUT=30000
UBER_AUTH_SESSION_TTL=300000

# --- Persistent per-company session browsers ---------------------------------
# Reidey Laravel API this service pushes captures + status to.
RIDY_API_URL=http://localhost:8090
# Must match the backend's DISPATCH_INGEST_SECRET (sent as X-Dispatch-Secret).
DISPATCH_INGEST_SECRET=local-dev-dispatch-secret
# Keep-warm cadence + early-renew window (ms).
WARM_INTERVAL_MS=21600000
WARM_BEFORE_EXPIRY_MS=43200000
# Tick + status-push cadence (ms).
WARM_TICK_MS=300000
STATUS_PUSH_MS=20000
# Hard cap on concurrent live browser contexts on this box.
MAX_SESSIONS=20
# Where each company's browser storage is saved for restart-resume.
STATE_DIR=./state
# Launch Chromium with --no-sandbox (set to 1 inside a container only).
NO_SANDBOX=0
# How often to reconcile live browsers with the backend's "wanted" list (ms).
SYNC_INTERVAL_MS=60000
# Gradual rollout: comma-separated tenant ids to auto-seed; empty = all active.
ONLY_TENANTS=
