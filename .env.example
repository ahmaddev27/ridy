# DASHCAM — root environment for docker-compose.yml.
# Copy to .env and fill in real values. The .env file is git-ignored and must
# never be committed (it holds secrets). Keep all data inside the EU (DSGVO).

# --- Application -------------------------------------------------------------
APP_NAME=DASHCAM
APP_ENV=production
# Generate once with: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

# --- Database (MySQL 8, used by the Compose stack) --------------------------
# NOTE: local dev (php artisan serve) uses sqlite instead — see README.
DB_DATABASE=dashcam
DB_USERNAME=dashcam
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# --- Redis (queues / cache / Horizon) ---------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# --- Frontend (Next.js) -----------------------------------------------------
# Base URL the browser uses to reach the Laravel API.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# --- Receipt vision (self-hosted Qwen3-VL-4B, docs/26) ---
# Set to http://receipt-vision:8080 to enable. In prod this is the GitHub secret
# RECEIPT_VISION_URL; deploy.yml then adds the vision compose profile itself.
# Empty = off (receipts stay on the phone ML Kit result).
RECEIPT_VISION_URL=

# Software passkey registration (docs/31) - all OFF when empty. In prod these come from
# GitHub secrets (deploy.yml rewrites .env each deploy); a company also needs its own
# tenants.settings.passkey.enabled flag. Set each secret to 1 to enable.
UBER_PASSKEY_REGISTER=
UBER_AUTH_PASSKEY_REGISTER=
UBER_AUTH_PASSKEY_COBROWSE=
