# Ridy — production environment for docker-compose.prod.yml
# Copy to `.env` on the server and fill in the values.

# ---- Domain / TLS ----------------------------------------------------------
# Canonical domain — used for generated links (invite emails, etc.).
DOMAIN=reidey.de
# Caddy site address = every domain to serve + auto-TLS. Comma-separate to run
# on MORE THAN ONE domain at once (handy while migrating):
#   SITE_ADDRESS=reidey.de, r.fleeteye.de
# Use ":80" for a quick HTTP-only test without a domain.
SITE_ADDRESS=reidey.de, r.fleeteye.de
# Make SPA-cookie login stateful on every served domain (comma-separated, no
# spaces). Leave unset to default to DOMAIN only.
SANCTUM_STATEFUL_DOMAINS=reidey.de,r.fleeteye.de
# Leave SESSION_DOMAIN empty so each domain keeps its own host-only session
# cookie (one cookie can't span two different apex domains).
SESSION_DOMAIN=
# Leave NEXT_PUBLIC_API_URL empty so the dashboard calls the API same-origin and
# works on every domain above without a rebuild. Set an absolute URL to override.
NEXT_PUBLIC_API_URL=

# ---- App -------------------------------------------------------------------
# Generate once with: docker compose -f docker-compose.prod.yml run --rm backend php artisan key:generate --show
APP_KEY=

# ---- Database (MySQL) ------------------------------------------------------
DB_DATABASE=ridy
DB_USERNAME=ridy
DB_PASSWORD=change-me-strong
DB_ROOT_PASSWORD=change-me-root-strong

# ---- Dispatch daemon <-> backend shared secret -----------------------------
# Any long random string; the daemon and backend must match.
DISPATCH_INGEST_SECRET=change-me-dispatch-secret

# ---- Residential proxy for Uber traffic ------------------------------------
# Uber blocks this server's datacenter IP (RAMEN 404s, getDrivers returns 0),
# so the daemon routes all Uber requests through a residential proxy. Get an
# endpoint from a provider (IPRoyal, Bright Data, Oxylabs, …). Leave blank to
# connect directly (works only from a real residential IP, not a server).
# Format: http://user:pass@host:port   (socks5://… also supported)
UBER_PROXY_URL=

# ---- Push notifications (optional) -----------------------------------------
# Leave blank to log pushes instead of sending. Set for real FCM.
FCM_SERVER_KEY=
