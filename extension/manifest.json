{
  "manifest_version": 3,
  "name": "Reidey Uber Connector",
  "version": "1.17.0",
  "description": "Verbindet deine Uber-Flottensitzung mit Reidey — melde dich normal bei Uber an, die Sitzung wird automatisch erfasst.",
  "permissions": ["cookies", "scripting", "storage", "alarms", "tabs"],
  "host_permissions": [
    "*://*.uber.com/*",
    "https://reidey.de/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://vsdispatch.uber.com/*", "*://supplier.uber.com/*", "*://fleethub.uber.com/*", "*://account.uber.com/*", "*://auth.uber.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://vsdispatch.uber.com/*", "*://supplier.uber.com/*", "*://fleethub.uber.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://reidey.de/*"],
      "js": ["pair.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Reidey Uber Connector",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ridy-uber-connector@fleeteye.de",
      "strict_min_version": "121.0"
    }
  }
}
