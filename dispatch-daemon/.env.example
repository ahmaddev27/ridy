# Every variable src/config.js reads. Only DISPATCH_INGEST_SECRET is required.
# Load it with `npm run dev` (node --env-file=.env) — `npm start` does NOT read
# .env (in Docker the env comes from docker-compose). Numeric values are plain
# integers in ms; an invalid value stops the daemon at startup.

# Ridy Laravel API base URL (https required unless it is a loopback address)
RIDY_API_URL=http://localhost:8090

# Shared secret — must match the backend's DISPATCH_INGEST_SECRET
DISPATCH_INGEST_SECRET=local-dev-dispatch-secret

# Shard identity (the backend returns only the companies assigned to it)
SHARD_ID=main

# Sentry DSN for daemon errors (empty = disabled)
SENTRY_DSN=

# Uber hosts (must be https://) and RAMEN channels (first = primary)
UBER_DISPATCH_BASE_URL=https://vsdispatch.uber.com
UBER_SUPPLIER_BASE_URL=https://fleethub.uber.com
UBER_RAMEN_PATHS=/ramendca/events,/ramenphx/events

# Fallback residential proxy for companies without their own proxy_url.
# http:// or https:// only (SOCKS is not supported). Empty = direct (Uber blocks it).
UBER_PROXY_URL=

# Polling cadence
SESSION_POLL_INTERVAL_MS=60000
ROSTER_INTERVAL_MS=1800000
STATUS_INTERVAL_MS=6000
STATUS_INTERVAL_ACTIVE_MS=3000
# Full status batch at least this often; in between only changed drivers are sent (0 = always full)
STATUS_FULL_SYNC_MS=30000

# Request deadlines
API_TIMEOUT_MS=8000
ROSTER_TIMEOUT_MS=15000
STATUS_TIMEOUT_MS=10000
HANDSHAKE_TIMEOUT_MS=20000
STREAM_IDLE_TIMEOUT_MS=90000

# Reconnect behaviour
RECONNECT_MIN_MS=2000
RECONNECT_MAX_MS=60000
STREAM_CYCLE_MS=250

# Fleet Hub (roster/status) degradation handling
SUPPLIER_RETRY_MS=60000
SUPPLIER_FAIL_THRESHOLD=3
SUPPLIER_DEGRADED_COOLDOWN_MS=600000
