# Ridy — production environment for docker-compose.prod.yml
# Copy to `.env` on the server and fill in the values.

# ---- Domain / TLS ----------------------------------------------------------
# Your domain. Used for generated links (invite emails, etc.).
DOMAIN=reidey.de
# Caddy site address = the domain to serve + auto-TLS (":80" for HTTP-only test).
SITE_ADDRESS=reidey.de
# NOTE: SPA-cookie login is stateful on DOMAIN automatically (derived from
# APP_URL) — no SANCTUM_STATEFUL_DOMAINS needed. Set DOMAIN + SITE_ADDRESS only.
# Empty = host-only session cookie for the domain.
SESSION_DOMAIN=
# Serve the session cookie only over HTTPS (production runs behind TLS).
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
# Empty = the dashboard calls the API same-origin (no rebuild needed per domain).
NEXT_PUBLIC_API_URL=

# ---- App -------------------------------------------------------------------
# Generate once with: docker compose -f docker-compose.prod.yml run --rm backend php artisan key:generate --show
APP_KEY=

# ---- Database (MySQL) ------------------------------------------------------
DB_DATABASE=ridy
DB_USERNAME=ridy
DB_PASSWORD=change-me-strong
DB_ROOT_PASSWORD=change-me-root-strong

# ---- Dispatch daemon <-> backend shared secret -----------------------------
# Any long random string; the daemon and backend must match.
DISPATCH_INGEST_SECRET=change-me-dispatch-secret

# ---- Residential proxy for Uber traffic ------------------------------------
# Uber blocks this server's datacenter IP (RAMEN 404s, getDrivers returns 0),
# so the daemon routes all Uber requests through a residential proxy. Get an
# endpoint from a provider (IPRoyal, Bright Data, Oxylabs, …). Leave blank to
# connect directly (works only from a real residential IP, not a server).
# Format: http://user:pass@host:port   (socks5://… also supported)
UBER_PROXY_URL=

# ---- Push notifications (optional) -----------------------------------------
# Leave blank to log pushes instead of sending. Set for real FCM.
FCM_SERVER_KEY=

# Real-time (Laravel Reverb / WebSocket). Generate once: `php artisan reverb:install`
# then copy the three values here. The app connects at wss://<DOMAIN>/app/<key>.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
