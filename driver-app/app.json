{
  "expo": {
    "name": "Reidey",
    "slug": "reidey",
    "scheme": "reidey",
    "version": "1.0.5",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "de.reidey.driver",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "de.reidey.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#14161b"
      },
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#080909",
          "sounds": [
            "./assets/sounds/normal.wav",
            "./assets/sounds/multi.wav"
          ]
        }
      ],
      "expo-asset",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#14171a"
        }
      ],
      "@sentry/react-native",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          },
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "@react-native-firebase/app",
        {
          "ios": {
            "disableSPM": true
          }
        }
      ],
      "@react-native-firebase/messaging",
      "./plugins/withExpoOwnsFcm.js"
    ],
    "extra": {
      "apiUrl": "https://reidey.de",
      "reverbHost": "reidey.de",
      "reverbKey": "8susv98cxftu6i3gzgfj",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "3a5c4d7f-5f4a-44b6-b3af-7c61f066d408"
      },
      "sentryDsn": "https://92105e781213e27f2d8026e2046d6cea@o4512028929294336.ingest.de.sentry.io/4512029017374800"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/3a5c4d7f-5f4a-44b6-b3af-7c61f066d408"
    },
    "owner": "reidey"
  }
}
