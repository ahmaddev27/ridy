# Ridy — production environment for docker-compose.prod.yml
# Copy to `.env` on the server and fill in the values.

# ---- Domain / TLS ----------------------------------------------------------
# Your domain. Caddy auto-obtains a Let's Encrypt certificate for it.
DOMAIN=r.fleeteye.de
# Caddy site address = the domain (use ":80" for a quick HTTP-only test).
SITE_ADDRESS=r.fleeteye.de

# ---- App -------------------------------------------------------------------
# Generate once with: docker compose -f docker-compose.prod.yml run --rm backend php artisan key:generate --show
APP_KEY=

# ---- Database (MySQL) ------------------------------------------------------
DB_DATABASE=ridy
DB_USERNAME=ridy
DB_PASSWORD=change-me-strong
DB_ROOT_PASSWORD=change-me-root-strong

# ---- Dispatch daemon <-> backend shared secret -----------------------------
# Any long random string; the daemon and backend must match.
DISPATCH_INGEST_SECRET=change-me-dispatch-secret

# ---- Push notifications (optional) -----------------------------------------
# Leave blank to log pushes instead of sending. Set for real FCM.
FCM_SERVER_KEY=
