{
  "expo": {
    "name": "Reidey Driver",
    "slug": "reidey",
    "scheme": "reidey",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "de.fleeteye.reidey.driver"
    },
    "android": {
      "package": "de.fleeteye.reidey.driver",
      "versionCode": 2,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#14161b"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#080909",
          "sounds": []
        }
      ],
      "expo-asset",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#14171a"
        }
      ],
      "@sentry/react-native"
    ],
    "extra": {
      "apiUrl": "https://reidey.de",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "f12e29c1-5bed-499b-8bfb-7dd3f8f87cc3"
      }
    },
    "owner": "jaberahmed22s-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f12e29c1-5bed-499b-8bfb-7dd3f8f87cc3"
    }
  }
}
